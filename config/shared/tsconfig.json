{
  "compilerOptions": {
    "target": "ES2022",
    // node16 (with no "type":"module" in package.json) emits CommonJS, which
    // resolves the barrel's directory re-exports (`export * from './api'`)
    // natively under raw Node — so @sitesurge/types is Node-loadable, not just
    // bundler-loadable, and the CJS api server can run `node dist` (no tsx).
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "../../packages/shared/dist",
    "rootDir": "../../packages/shared/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["../../packages/shared/src/**/*"],
  // Tests are excluded from the BUILD, not just tidied away: @sitesurge/types
  // is published to npm, and a compiled `dist/**/*.test.js` both ships dead
  // weight to consumers and gets picked up as a second, stale copy of every
  // suite the next time vitest runs (it scans dist too, so a compiled test
  // that no longer matches its source fails for no real reason).
  "exclude": [
    "../../packages/shared/node_modules",
    "../../packages/shared/dist",
    "../../packages/shared/src/**/*.test.ts"
  ]
}
