# ===========================================
# RW Backend Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://rw:rw@localhost:5432/rw
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=1h
JWT_REFRESH_TOKEN_EXPIRES=7d

# Patreon OAuth Configuration
# Get these from https://www.patreon.com/portal/registration/register-clients
PATREON_CLIENT_ID=your-patreon-client-id
PATREON_CLIENT_SECRET=your-patreon-client-secret
PATREON_REDIRECT_URI=http://localhost:3001/api/v1/auth/patreon/callback
PATREON_CAMPAIGN_ID=your-patreon-campaign-id

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email Configuration (SMTP) — works with any SMTP relay. Used for BOTH
# transactional email (signup verification, receipts) and mailing-list sends.
# The transport pools connections + applies socket timeouts automatically.
# Recommended free option: Brevo (smtp-relay.brevo.com:587, 300/day free).
# Other tested relays: Postmark, SendGrid, Mailgun, AWS SES, Resend.
# AWS SES / Mail Manager SMTP: use the SMTP endpoint host, port 587,
# SMTP_SECURE=false (STARTTLS). If a password has shell-special chars,
# single-quote it in .env so it isn't mangled, e.g. SMTP_PASS='a^b?c|d'.
# EMAIL_FROM must be on a verified sending domain (e.g. no-reply@mail.example.com).
# For local dev, point at Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
# Transactional FROM (signup verification, receipts, welcome). Use a subdomain
# dedicated to transactional mail so its deliverability reputation is isolated
# from bulk sends, e.g. no-reply@mail.example.com.
EMAIL_FROM=SiteSurge <noreply@example.com>
# Optional: separate FROM for BULK mailing-list sends (own subdomain →
# isolated reputation). Falls back to EMAIL_FROM when unset. A per-template
# "From email" still overrides this. e.g. newsletter@lists.example.com
# MAIL_LIST_FROM=SiteSurge <newsletter@lists.example.com>

# Mailing Lists feature module — required when the feature is enabled.
# Welcome / donation-receipt emails also route through the same provider.
MAIL_PROVIDER=smtp                       # smtp | mailgun | sendgrid | postmark  (only smtp is implemented today)
MAIL_SEND_CONCURRENCY=10                 # parallel sends per worker chunk
MAIL_SEND_DELAY_MS=50                    # pause between chunks (rate-limit friendly)
# HMAC key for /u/<token> unsubscribe links. Falls back to JWT_SECRET if unset, but set
# explicitly so rotating JWT_SECRET doesn't invalidate existing unsubscribe links.
# Generate one with: openssl rand -hex 32
MAIL_UNSUBSCRIBE_SECRET=

# File Upload Configuration
# Maximum upload file size in MB (default: 500MB)
UPLOAD_MAX_SIZE_MB=500
UPLOAD_DIR=./uploads
# Storage provider: 'local' (saves to UPLOAD_DIR) or 's3' (uploads to AWS S3)
STORAGE_PROVIDER=local
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,audio/mpeg,audio/wav,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/zip

# S3 / S3-compatible storage (required if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=rw-media-uploads
# Optional CDN URL (CloudFront, or an R2/B2 public/custom domain). If not set,
# falls back to the AWS S3 bucket URL. REQUIRED when using a custom S3_ENDPOINT
# (R2/B2/MinIO), since the raw endpoint isn't publicly servable.
S3_CDN_URL=https://cdn.ryanweiss.net
# Custom S3-compatible endpoint for non-AWS providers. Leave unset for AWS S3.
#   Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
#   Backblaze B2:  https://s3.<region>.backblazeb2.com
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Social Media API Keys
# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_ACCESS_TOKEN=your-facebook-page-access-token

# Instagram (uses Facebook Graph API)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id

# Twitter/X API
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_USERNAME=rw

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# TikTok (optional)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Admin Configuration
# Email addresses that should automatically be granted admin role
ADMIN_EMAILS=admin@ryanweiss.net
