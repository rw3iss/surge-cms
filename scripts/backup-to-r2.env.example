# Copy to /etc/surge-backup.env (chmod 600) and fill in. Read by surge-backup.
DATABASE_URL=postgres://surge:CHANGE-ME@localhost:5432/surge
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=surge-backups
AWS_ACCESS_KEY_ID=<R2 access key id>
AWS_SECRET_ACCESS_KEY=<R2 secret access key>
AWS_DEFAULT_REGION=auto

# Retention (days) for both local staging and R2.
RETAIN_DAYS=14
LOCAL_STAGE_DIR=/var/backups/surge

# Only set while media is still on LOCAL disk (STORAGE_PROVIDER=local). Once
# media is on R2 it's already durable — leave this unset to skip media tarballs.
# BACKUP_MEDIA_DIR=/var/www/surge-media/uploads

# Optional: a healthchecks.io (or similar) URL pinged on success. A missed ping
# alerts you that the nightly backup failed.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
